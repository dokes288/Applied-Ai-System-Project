# Copy to .env (or export in your shell) to enable the live Claude RAG path.
# Without a key, VibeMatch runs the deterministic offline path automatically.
#
#   Windows PowerShell:  $env:ANTHROPIC_API_KEY = "sk-ant-..."
#   macOS / Linux:       export ANTHROPIC_API_KEY="sk-ant-..."

ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5).
# VIBEMATCH_MODEL=claude-opus-5

# Optional: set to 1 to see INFO-level pipeline logs (parse/retrieve/generate).
# VIBEMATCH_DEBUG=1
